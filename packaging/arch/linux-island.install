post_install() {
    cat <<'MSG'
==> Linux Island installed.
    GNOME:  log out and back in, then run
              gnome-extensions enable linux-island@miverasan.com
            Super+Alt+H opens the island, Super+Alt+N the notification list.
    Others: it starts at your next login (or run `linux-island` now).
            Bind `linux-island --toggle` to a key in your desktop settings.
MSG
}

post_upgrade() {
    echo "==> Linux Island updated. GNOME: log out and back in to load the new version."
}
